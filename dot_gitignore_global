# Global gitignore (chezmoi: dot_gitignore_global -> ~/.gitignore_global)
# Loaded via `core.excludesfile` in dot_gitconfig; applies to all repos.
# Keep project-specific ignores in repo-local .gitignore. Categories below.

# --- OS / backups ---
.DS_Store
*~
*.swp
*.swo
*.bak

# --- Editors / IDEs ---
.vscode
.idea
*.iml

# --- Logs / LaTeX intermediates ---
*.aux
*.log*

# --- Python / virtualenvs ---
*.venv
__pycache__/
.tox

# --- Node / caches ---
node_modules/
*.cache

# --- Build outputs ---
dist/
build/
target/
bin/

# --- Coding agent ---
**/.claude
**/.omc
**/.pi

# Note: `*.git` typo line removed (was ambiguous — likely *.orig/*.patch merge residue).
# If you need to ignore git internals, use an explicit pattern with a comment.
**/.git
