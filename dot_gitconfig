[core]
	editor = 'code'
	autocrlf = input
	excludesfile = ~/.gitignore_global
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[user]
	name = azwpayne
	email = paynewu0719@gmail.com
[init]
	defaultBranch = main

# NOTE: GitHub HTTPS 仅有此代理 socks5://127.0.0.1:5376，代理离线时无直连回退；
# 临时恢复直连：git config --global --unset http.https://github.com.proxy
[http "https://github.com"]
	proxy = socks5://127.0.0.1:5376

[push]
	default = current
	autoSetupRemote = true
[safe]
	directory = *
