{
  "enabled": true,
  "shell": {"readAccess": "host"},
  "filesystem": {
    "denyRead": ["/Users", "/home", "/root", "/etc", "/var", "/private/var", "/private/tmp"],
    "allowRead": [".", "~/.gitconfig", "~/.config/git/config", "/dev/null", "${HOME}/.pi/agent/npm/node_modules/**"],
    "allowWrite": [".", "/dev/null", "/tmp", "~/.npm", "~/.cargo/registry", "~/.cache", "~/.config/git/config"],
    "denyWrite": [
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      ".pi/sandbox.json",
      "~/.pi/agent/sandbox.json",
      "~/.ssh",
      "~/.bashrc",
      "~/.zshrc",
      "~/.profile",
      "~/.gitconfig",
      "**/.git"
    ]
  },
  "network": {
    "allowNetwork": false,
    "allowLocalBinding": false,
    "allowAllUnixSockets": false,
    "allowUnixSockets": [],
    "allowedDomains": ["github.com", "*.github.com", "*.githubusercontent.com"],
    "deniedDomains": []
  },
  "windows": {"appContainerMode": "standard", "allowLoopback": false}
}