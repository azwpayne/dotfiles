{
    "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
    "promptMaxRows": 32,
    "permission": {
        "*": "allow",
        "mcp": {"*": "ask", "mcp_status": "allow", "mcp_list": "allow"},
        "skill": {"*": "ask"},
        "read": {
            "*"            : "allow",
            "*.env"        : "deny",
            "*.env.*"      : "deny",
            "*.env.example": "allow",
            "~/.ssh/*"     : "deny",
            "~/.aws/*"     : "deny",
            "~/.gnupg/*"   : "deny"
        },
        "write": {"*": "allow", "*.env": "deny", "*.env.*": "deny", "~/.ssh/*": "deny", "~/.aws/*": "deny"},
        "edit": {"*": "allow", "*.env": "deny", "*.env.*": "deny", "~/.ssh/*": "deny", "~/.aws/*": "deny"},
        "bash": {
            "*"           : "ask",
            "tail *"      : "allow",
            "sleep *"     : "allow",
            "ps *"        : "allow",
            "lsof *"      : "allow",
            "find *"      : "allow",
            "wc *"        : "allow",
            "sed *"       : "allow",
            "head *"      : "allow",
            "awk *"       : "allow",
            "grep *"      : "allow",
            "pwd"         : "allow",
            "for *"       : "allow",
            "cd *"        : "allow",
            "ls *"        : "allow",
            "cat *"       : "allow",
            "echo *"      : "allow",
            "mkdir *"     : "allow",
            "touch *"     : "allow",
            "sudo *"      : "deny",
            "mv *"        : "deny",
            "rm *"        : "deny",
            "unlink *"    : "deny",
            "dd if=* of=*": "deny",
            "mkfs.*"      : "deny",
            // git
            "git *"       : "allow",
            "git rm *"    : "deny",
            // script
            "node -e"     : "ask",
            "npm install" : "ask",
            "npm ci"      : "ask",
            "pnpm *"      : "ask",
            "cargo *"     : "ask"
        },
        "path": {
            "*"            : "allow",
            "*.env"        : "deny",
            "*.env.*"      : "deny",
            "*.env.example": "allow",
            "*.pem"        : "deny",
            "*.key"        : "deny",
            "~/.ssh/*"     : "deny",
            "/etc/*"       : "deny",
            "/var/*"       : "deny"
        },
        "external_directory": {"*": "ask", "~/.cargo/registry/*": "allow", "~/.npm/*": "allow", "~/.cache/*": "allow"}
    }
}
