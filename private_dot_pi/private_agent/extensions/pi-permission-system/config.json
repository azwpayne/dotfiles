{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": true,
  "promptMaxRows": 8,
  "permission": {
    "*": "allow",
    "mcp": {
      "*": "allow",
      "mcp_status": "allow",
      "exa:*": "allow"
    },
    "skill": {
      "*": "allow",
      "librarian": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny"
    },
    "write": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "mv *": "deny",
      "rm *": "deny",
      "unlink *": "deny",
      "dd if=* of=*": "deny",
      "mkfs.*": "deny",
      "python3 *": "ask",
      "node *": "ask"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "/etc/*": "deny",
      "/var/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.cargo/registry/*": "allow",
      "~/.npm/*": "allow",
      "~/.cache/*": "allow"
    }
  }
}
